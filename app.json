{
  "expo": {
    "name": "TeamTime",
    "slug": "teamtime",
    "version": "4.0.0",
    "scheme": "teamtime",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gmail.mauriziopolverini89.teamtime",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gmail.mauriziopolverini89.teamtime",
      "versionCode": 93
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-name.png",
          "imageWidth": 260,
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TeamTime usa la fotocamera per scansionare il QR Code all'entrata e all'uscita dal lavoro.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Se la tua azienda lo richiede, TeamTime registra la posizione al momento della timbratura."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-mail-composer",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "teamtime-registro-presenze",
          "project": "teamtime-app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a50bd93d-3963-48a2-a8f4-1ef677992c0d"
      }
    },
    "owner": "mauyellow"
  }
}
