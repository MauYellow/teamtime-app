# Copia questo file in .env e inserisci i valori. Non committare .env.
# Indirizzo del proxy TeamTime (SPEC §18): tutte le chiavi private stanno lì, non nell'app.
# In locale l'IP del PC con il proxy acceso (npm run dev in teamtime-proxy), es. http://192.168.1.49:8000;
# per le build l'URL di Koyeb (variabile anche su expo.dev).
EXPO_PUBLIC_PROXY_URL=
# Chiavi PUBBLICHE di RevenueCat (fatte per stare nell'app).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# DSN di Sentry (pubblico per natura: permette solo di inviare errori).
EXPO_PUBLIC_SENTRY_DSN=
