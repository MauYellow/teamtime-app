# Token Airtable con lettura e scrittura sulla base Presenze (appOwBv51ihqoT7Cx).
# Copia questo file in .env e inserisci i valori. Non committare .env.
EXPO_PUBLIC_AIRTABLE_TOKEN=
# Chiave di geocode.maps.co (indirizzo dalla posizione GPS).
EXPO_PUBLIC_GEOCODE_API_KEY=
# Chiave Brevo (registrazione azienda, tappa 4).
EXPO_PUBLIC_BREVO_API_KEY=
# Log su Telegram: token del bot e id del canale (prima stavano nel foglio "TeamTime - App Settings").
EXPO_PUBLIC_TELEGRAM_BOT_KEY=
EXPO_PUBLIC_TELEGRAM_CHANNEL_ID=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
